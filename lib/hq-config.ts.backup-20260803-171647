export type HqOfficeConfig = {
  background: string;
};

export const HQ_OFFICES: Partial<
  Record<string, HqOfficeConfig>
> = {
  bears: { background: "/hq/bears.jpg" },
  bills: { background: "/hq/bills.jpg" },
  dolphins: { background: "/hq/dolphins.jpg" },
  packers: { background: "/hq/packers.jpg" },
  chiefs: { background: "/hq/chiefs.jpg" },
  raiders: { background: "/hq/raiders.jpg" },
  saints: { background: "/hq/saints.jpg" },
  "49ers": { background: "/hq/49ers.jpg" },
  cowboys: { background: "/hq/cowboys.jpg" },
};

export function getHqOfficeConfig(
  teamSlug: string,
): HqOfficeConfig | null {
  return HQ_OFFICES[teamSlug] ?? null;
}
